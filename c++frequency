#include <iostream>
using namespace std;

int main()
{
    int rating[10];
    int frequency[4] = {0};

    cout << "Enter 10 responses: ";

    for (int i = 0; i < 10; i++)
    {
        cin >> rating[i];

        while (rating[i] < 1 || rating[i] > 3)
        {
            cout << "Invalid! Enter rating 1-3: ";
            cin >> rating[i];
        }

        frequency[rating[i]]++;
    }

    cout << "\nRating\tFrequency" << endl;

    for (int i = 1; i <= 3; i++)
    {
        cout << i << "\t" << frequency[i] << endl;
    }

    return 0;
}
