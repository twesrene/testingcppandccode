#include<iostream>
using namespace std;
int main(){
    int arr[10]={23, 89, 1, 92, 67, 99, 12, 7, 19, 8}, value,found;
    cout<<"Input your value: ";
    cin>>value;

    for(int i = 0;i < 10;i++){
        if(arr[i]==value){
            found = 1;
            break;
        }
    }
    if (found != -1) {
        cout << "Integer value found in index element " << found << endl;
    } else {
        cout << "Integer not found" << endl;
    }
    int great = 0;
    for (int i = 0; i < 10; i++) {
        if (arr[i] > value) {
            great++;
        }
    }
    int percentage = (great * 100) / 10;
    cout << "There are " << percentage << "% of the integers in the array
    that are greater than " << value << "." << endl;

}
